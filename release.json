{
  "schema": "release-tools/app/v1",
  "app": "paw-proxy",
  "repo": "alexcatdad/paw-proxy",
  "checks": [
    "check",
    "vulncheck"
  ],
  "targets": [
    {
      "id": "darwin-arm64",
      "os": "darwin",
      "arch": "arm64",
      "min_os": "13.0",
      "runs": "local",
      "build_task": "build:darwin-arm64",
      "validate_task": "validate:darwin-arm64",
      "artifacts": [
        {
          "name": "Paw-Proxy.app.zip",
          "kind": "zip"
        }
      ]
    },
    {
      "id": "linux-amd64",
      "os": "linux",
      "arch": "amd64",
      "min_os": "fedora-42",
      "runs": "any",
      "build_task": "build:linux-amd64",
      "artifacts": [
        {
          "name": "paw-proxy-linux-amd64",
          "kind": "binary"
        },
        {
          "name": "up-linux-amd64",
          "kind": "binary"
        },
        {
          "name": "man-pages.tar.gz",
          "kind": "tar.gz"
        }
      ]
    },
    {
      "id": "linux-arm64",
      "os": "linux",
      "arch": "arm64",
      "min_os": "fedora-42",
      "runs": "any",
      "build_task": "build:linux-arm64",
      "artifacts": [
        {
          "name": "paw-proxy-linux-arm64",
          "kind": "binary"
        },
        {
          "name": "up-linux-arm64",
          "kind": "binary"
        }
      ]
    }
  ],
  "signing": {
    "macos": {
      "targets": [
        "darwin-arm64"
      ],
      "notarize": true,
      "staple": true
    }
  },
  "migration": {
    "floor": "1.12.3"
  },
  "taps": [
    {
      "repo": "alexcatdad/homebrew-tap",
      "kind": "cask",
      "package": "paw-proxy"
    },
    {
      "repo": "alexcatdad/homebrew-tap",
      "kind": "formula",
      "package": "paw-proxy",
      "targets": [
        "linux-amd64",
        "linux-arm64"
      ]
    }
  ]
}
