{
  "schema": "release-tools/app/v1",
  "app": "paw-proxy",
  "repo": "alexcatdad/paw-proxy",
  "checks": [
    "check"
  ],
  "targets": [
    {
      "id": "darwin-arm64",
      "os": "darwin",
      "arch": "arm64",
      "min_os": "13.0",
      "runs": "local",
      "build_task": "build:darwin-arm64",
      "validate_task": "validate:darwin-arm64",
      "artifacts": [
        {
          "name": "Paw-Proxy.app.zip",
          "kind": "zip"
        }
      ]
    }
  ],
  "signing": {
    "macos": {
      "targets": [
        "darwin-arm64"
      ],
      "notarize": true,
      "staple": true
    }
  },
  "migration": {
    "floor": "1.12.3"
  },
  "taps": [
    {
      "repo": "alexcatdad/homebrew-tap",
      "kind": "cask",
      "package": "paw-proxy"
    }
  ]
}
